# Copy this file to .env if you want environment variables.
# Fill these from Google Cloud → APIs & Services → Credentials.
# Never put real secrets in this example file.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Shared secret for the local MCP client. Google OAuth does not authenticate
# the process that starts this server. The legitimate client must pass the
# same value as MCP_CALLER_TOKEN. Do not commit a real token.
MCP_GATEWAY_TOKEN=replace-with-a-long-random-secret
